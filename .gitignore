# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf le fichier d'exemple, qui ne contient aucune vraie valeur
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Requêtes enregistrées par Supabase Studio en local (peuvent contenir des
# données personnelles)
supabase/snippets/

# Tests de bout en bout (Playwright) : rapports et traces
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Windows et éditeurs
Thumbs.db
desktop.ini
*.swp
.idea/

# Journaux et clés
*.log
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
signing_keys.json
service-account*.json

# Dépôt public : jamais d'export ni de copie de données (candidats,
# paiements, prospection), où qu'ils soient posés
*.csv
*.xlsx
*.xls
*.sql.gz
*.dump
*.backup

# Supabase en local : projet lié en ligne (adresse de la base, pooler)
supabase/.temp/
supabase/.branches/

# Sauvegardes et clés age : jamais dans le dépôt
*.age
cle-privee*

# supports marketing (vidéo Remotion…), gardés hors du dépôt
/marketing/

# documentation locale (schéma d'architecture…), gardée hors du dépôt
/docs/

# Outils de Claude Code (skills) : gardés sur cet ordinateur seulement
.claude/
