# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez jamais .env.local.

# Supabase (local : `npx supabase status -o env` ; en ligne : Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, jamais dans le navigateur
SUPABASE_SECRET_KEY=

# Chiffrement des mots de passe des comptes externes : 32 octets en base64.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# À sauvegarder hors du dépôt : la perdre rend les mots de passe illisibles.
EXTERNAL_ACCOUNTS_ENCRYPTION_KEY=

# Facultatif. En-tête qui porte l'adresse IP du visiteur, pour les limites
# d'essais (connexion des candidats, inscriptions). Par défaut
# x-forwarded-for, dont on lit la dernière adresse : correct sur Vercel et
# derrière nginx. Derrière Cloudflare : cf-connecting-ip.
# CLIENT_IP_HEADER=

# Facultatif. Numéro affiché aux agences pour renouveler leur abonnement
# (bandeaux d'essai et d'expiration, page Équipe). Sans lui : « contactez-nous ».
# SUPPORT_PHONE=0550 00 00 00
