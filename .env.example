# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez jamais .env.local.

# Supabase (local : `npx supabase status -o env` ; en ligne : Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, jamais dans le navigateur
SUPABASE_SECRET_KEY=

# Chiffrement des mots de passe des comptes externes : 32 octets en base64.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# À sauvegarder hors du dépôt : la perdre rend les mots de passe illisibles.
EXTERNAL_ACCOUNTS_ENCRYPTION_KEY=

# Facultatif. En-tête qui porte l'adresse IP du visiteur, pour les limites
# d'essais (connexion des candidats, inscriptions). Par défaut
# x-forwarded-for, dont on lit la dernière adresse : correct sur Vercel et
# derrière nginx. Derrière Cloudflare : cf-connecting-ip.
# CLIENT_IP_HEADER=

# Facultatif. Numéro affiché aux agences pour renouveler leur abonnement
# (bandeaux d'essai et d'expiration, page Équipe). Sans lui : « contactez-nous ».
# SUPPORT_PHONE=0550 00 00 00

# Facultatif. Suivi des erreurs (Sentry > Project Settings > Client Keys).
# À définir seulement en production (Vercel : environnement « Production »),
# avant le build : la valeur est intégrée au code du navigateur. Sans elle,
# rien n'est envoyé (local, tests). Pas secret : sert seulement à envoyer.
# NEXT_PUBLIC_SENTRY_DSN=…

# Facultatif. Adresse publique du site, pour les liens des e-mails et les
# aperçus de liens. Par défaut https://www.tremplia.com. En local :
# SITE_URL=http://127.0.0.1:3000

# E-mails de l'application (confirmation d'adresse, mot de passe oublié,
# rappels d'abonnement). En production : clé Resend (permission « Sending
# access », domaine tremplia.com). Secret, serveur uniquement.
# RESEND_API_KEY=re_…
# En local, sans clé Resend : boîte de test du Supabase local (Mailpit),
# lisible sur http://127.0.0.1:54324
MAILPIT_URL=http://127.0.0.1:54324

# Notifications sur le téléphone ou l'ordinateur (Web Push). Sans elles,
# Réglages › Notifications indique « pas encore disponibles ». Générer une
# fois : npx web-push generate-vapid-keys
# La publique est donnée aux navigateurs ; la privée est secrète (serveur
# uniquement). Les changer oblige chacun à réactiver ses notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Tâches planifiées (rappels d'abonnement) : secret partagé avec GitHub
# Actions (secret CRON_SECRET du dépôt). Générer :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=
